                "nombre",
                "email",
                "contrasena",
                "rol"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente"
          },
          "400": {
            "description": "Campos requeridos faltantes o inválidos"
          },
          "409": {
            "description": "Nombre o email ya registrado"
